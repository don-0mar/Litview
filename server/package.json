{
  "name": "litview-api",
  "version": "1.0.0",
  "description": "Backend for Litview: accounts, saved reviews, team screening, database search proxy and AI-assisted synthesis.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file=.env src/index.js",
