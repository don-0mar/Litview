# Copy to .env for local development. On Render, set these under Environment.

# Postgres connection string. Locally: postgres://litview:litview@localhost:5432/litview
# On Neon, copy the connection string from the dashboard (it includes ?sslmode=require).
DATABASE_URL=postgres://litview:litview@localhost:5432/litview

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Front-end sites allowed to call the API, comma-separated.
ALLOWED_ORIGINS=https://don-0mar.github.io,http://localhost:8080

# Optional: your email, sent to OpenAlex and Crossref for their faster "polite pool".
CONTACT_EMAIL=

# Optional database keys. Leave blank to fall back to Crossref and file imports.
SCOPUS_API_KEY=        # https://dev.elsevier.com
SCOPUS_INST_TOKEN=     # only if your institution gives you one
IEEE_API_KEY=          # https://developer.ieee.org
SPRINGER_API_KEY=      # https://dev.springernature.com

# Optional: turns on AI-assisted synthesis. https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_MAX_STUDIES=120
